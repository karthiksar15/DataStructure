    public static boolean checkInDFS(Map<Integer, List<Integer>> adjLst, int src, int destination, boolean[] visited) {
        Deque<Integer> st = new LinkedList<>();
        st.add(src);
        visited[src] = true;
        while (!st.isEmpty()) {
            int temp = st.pop();
            if (temp == destination)
                return true;
            if (adjLst.get(temp) != null) {
                for (Integer adj : adjLst.get(temp)) {
                    if (!visited[adj]) {
                        st.push(adj);
                        visited[adj] = true;
                    }

                }
            }

        }

        return false;
    }

    public static boolean checkInDFSRecur(Map<Integer, List<Integer>> adjLst, int src, int destination,
            boolean[] seen) {
        if (src == destination)
            return true;
        if (!seen[src]) {
            seen[src] = true;
            for (int currNode : adjLst.get(src)) {
                if (checkInDFSRecur(adjLst, currNode, destination, seen)) {
                    return true;
                }
            }
        }
        return false;
    }

    public static boolean checkInBFS(Map<Integer, List<Integer>> adjMap, Integer src, Integer destination,
            boolean[] visited) {
        Queue<Integer> queue = new LinkedList<>();
        if (src.equals(destination))
            return true;
        queue.add(src);
        visited[src] = true;
        while (!queue.isEmpty()) {
            src = queue.poll();
            if (src.intValue() == destination.intValue()) {
                return true;
            }
            for (Integer i : adjMap.get(src)) {
                if (!visited[i]) {
                    queue.add(i);
                    visited[i] = true;
                }
            }

        }
        return false;
    }

    public static boolean checkInDisjoint(Map<Integer, List<Integer>> adjMap, Integer src, Integer destination,
            boolean[] visited, int size) {
