            Integer fromNode = adj.getKey();
            // address.put(fromNode, count);
            for (Integer toNode : adj.getValue()) {
                dis.union(fromNode, toNode);
            }

        }

        if (dis.find(src) == dis.find(destination))
            return true;
        return false;

    }

}
